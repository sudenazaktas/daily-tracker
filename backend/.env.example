# === Veritabanı (Neon) ===
# Neon panelinden alınan connection string. Sonunda ?sslmode=require olmalı.
DATABASE_URL=postgresql://kullanici:sifre@ep-xxx.eu-central-1.aws.neon.tech/daily_tracker_db?sslmode=require

# === Strapi ===
# Deploy edilen Strapi servisinin public URL'i (Render adresi).
STRAPI_URL=https://daily-tracker-strapi.onrender.com

# Strapi'nin users-permissions JWT secret'ı ile AYNI olmalı (token doğrulaması için).
JWT_SECRET=strapi_ile_ayni_jwt_secret

# === Dış servis anahtarları ===
TAVILY_API_KEY=tvly-xxxxxxxx
GEMINI_API_KEY=xxxxxxxx
GEMINI_MODEL=gemini-3.5-flash-lite

# === E-posta (Gmail SMTP) ===
# Kendi Gmail'inden herkese gönderim (domain gerekmez).
# GMAIL_APP_PASSWORD: Google hesabı > Güvenlik > Uygulama Şifreleri'nden alınan 16 haneli şifre.
GMAIL_USER=snazaktas@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# === Üretim ayarları ===
# Frontend'in adresi (virgülle birden fazla verilebilir). CORS için.
ALLOWED_ORIGINS=https://daily-tracker.vercel.app

# Ücretsiz sunucu uykuya geçtiği için üretimde false yapıp dış cron kullanılır.
ENABLE_SCHEDULER=false

# /jobs/run-daily endpoint'ini korumak için rastgele uzun bir gizli anahtar.
# GitHub Actions cron'u bu değeri X-Job-Secret başlığında gönderecek.
JOB_SECRET=uzun_rastgele_bir_deger
